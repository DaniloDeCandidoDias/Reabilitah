{
  "name": "reabilitah",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test": "tsx --test tests/*.test.ts",
    "test:access": "tsx tests/access.integration.ts",
    "test:bootstrap": "tsx tests/bootstrap.integration.ts",
    "test:management": "tsx tests/management.integration.ts",
    "test:concurrency": "tsx tests/management-concurrency.integration.ts",
    "test:web": "playwright test",
    "setup:local": "node --env-file-if-exists=.env.local --import tsx scripts/setup-local.ts"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module"
}
